# Apache-only configuration — GitHub Pages ignores .htaccess entirely.
# Keep this file out of the published site; copy it to the web root if the
# site ever moves to Apache/cPanel hosting.

# Canonical host: https://fisioalemanha.de (apex, HTTPS, no /index.html)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Force apex (www -> non-www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 3. /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # 4. /path.html -> /path (optional, only if you add more pages)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]
</IfModule>

# Custom error document
ErrorDocument 404 /404.html

# UTF-8 for text assets
AddDefaultCharset UTF-8

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Only enable HSTS once HTTPS works for every hostname:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caching: HTML revalidates, hashed/static assets can be cached longer
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# Never serve dotfiles or the deploy folder
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/deploy/
